# Dependencies (root + any nested project)
**/node_modules

# Build outputs / incremental caches
dist
frontend/dist
*.tsbuildinfo

# Other subprojects — not part of the backend image
frontend
mobile
extension

# Tests, docs, CI, coverage — not needed to build or run the backend
test
coverage
docs
.github

# Env & secrets — must never be baked into image layers
**/.env
**/.env.*

# VCS / editor / OS cruft
.git
.gitignore
**/.DS_Store
*.md

# Large generated artifact (regenerated from source; not needed at build/runtime)
openapi.json
