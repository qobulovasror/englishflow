generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  // Tracks the moment of the last password change; any JWT issued before this
  // is considered invalid by `JwtStrategy.validate`.
  passwordChangedAt DateTime @default(now())
  // Self-reported CEFR level chosen during onboarding; drives deck suggestions.
  level             CefrLevel?
  // Null until the user finishes (or skips) onboarding. Clients use this to
  // decide whether to show the onboarding flow.
  onboardedAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words         Word[]
  userWords     UserWord[]
  tests         Test[]
  refreshTokens RefreshToken[]
  decks         Deck[]           @relation("UserDecks")
  enrollments   DeckEnrollment[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  // SHA-256 of the opaque token string. We never persist the plaintext.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Word {
  id          String   @id @default(uuid())
  word        String
  translation String
  example     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Null for words that belong to a curated/system deck (no individual owner).
  // User-created words still set this.
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  // Words sourced from a deck reference it here. Personal words created via
  // POST /words have a null deckId until Phase C introduces a personal deck.
  deckId String?
  deck   Deck?   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  userWords     UserWord[]
  testQuestions TestQuestion[]

  @@index([createdById])
  @@index([deckId])
  @@map("words")
}

enum WordStatus {
  NEW
  LEARNING
  LEARNED
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model Deck {
  id          String     @id @default(uuid())
  title       String
  description String?
  level       CefrLevel?
  // Curated content shipped with the app (createdById is null). User-built
  // decks set createdById and default to private.
  isSystem    Boolean    @default(false)
  isPublic    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  createdById String?
  createdBy   User?      @relation("UserDecks", fields: [createdById], references: [id], onDelete: Cascade)

  words       Word[]
  enrollments DeckEnrollment[]

  @@index([isSystem])
  @@index([level])
  @@index([createdById])
  @@map("decks")
}

// Tracks which decks a user has joined. Distinct from UserWord, which holds the
// per-word learning progress; enrollment is for organisation and re-sync.
model DeckEnrollment {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  deckId String
  deck   Deck   @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([userId, deckId])
  @@index([deckId])
  @@map("deck_enrollments")
}

model UserWord {
  id              String     @id @default(uuid())
  status          WordStatus @default(NEW)
  repetitionCount Int        @default(0)
  lastReviewedAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([wordId])
  @@index([status])
  @@map("user_words")
}

model Test {
  id        String   @id @default(uuid())
  score     Int      @default(0)
  // Null while the quiz is in progress. `submitTest` sets it once and refuses
  // to grade a test that already has it — a test can be submitted exactly once,
  // so a client can't replay or fabricate scores.
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questions TestQuestion[]

  @@index([userId])
  @@map("tests")
}

model TestQuestion {
  id             String  @id @default(uuid())
  // Null until the test is submitted. The server writes `correctAnswer` at
  // start time (the answer key the client never sees); `selectedAnswer` is
  // filled in only when the user submits their choice.
  selectedAnswer String?
  correctAnswer  String

  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([wordId])
  @@map("test_questions")
}
