generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  // Tracks the moment of the last password change; any JWT issued before this
  // is considered invalid by `JwtStrategy.validate`.
  passwordChangedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words         Word[]
  userWords     UserWord[]
  tests         Test[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  // SHA-256 of the opaque token string. We never persist the plaintext.
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Word {
  id          String   @id @default(uuid())
  word        String
  translation String
  example     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  userWords     UserWord[]
  testQuestions TestQuestion[]

  @@index([createdById])
  @@map("words")
}

enum WordStatus {
  NEW
  LEARNING
  LEARNED
}

model UserWord {
  id              String     @id @default(uuid())
  status          WordStatus @default(NEW)
  repetitionCount Int        @default(0)
  lastReviewedAt  DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@index([wordId])
  @@index([status])
  @@map("user_words")
}

model Test {
  id        String   @id @default(uuid())
  score     Int      @default(0)
  // Null while the quiz is in progress. `submitTest` sets it once and refuses
  // to grade a test that already has it — a test can be submitted exactly once,
  // so a client can't replay or fabricate scores.
  submittedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  questions TestQuestion[]

  @@index([userId])
  @@map("tests")
}

model TestQuestion {
  id             String  @id @default(uuid())
  // Null until the test is submitted. The server writes `correctAnswer` at
  // start time (the answer key the client never sees); `selectedAnswer` is
  // filled in only when the user submits their choice.
  selectedAnswer String?
  correctAnswer  String

  testId String
  test   Test   @relation(fields: [testId], references: [id], onDelete: Cascade)

  wordId String
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([wordId])
  @@map("test_questions")
}
