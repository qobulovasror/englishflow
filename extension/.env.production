# Production build target — used by `wxt build` (production mode).
# https://englishflow.mindcore.uz serves the web app; its nginx reverse-proxies
# /api/* to the NestJS backend (so /api/auth/login -> backend /auth/login).
WXT_API_URL=https://englishflow.mindcore.uz/api
WXT_WEB_URL=https://englishflow.mindcore.uz
