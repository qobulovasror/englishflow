NODE_ENV=development
PORT=3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/englishflow?schema=public"

# JWT — keep access tokens short-lived; clients rotate them via /auth/refresh.
JWT_SECRET="REPLACE_WITH_RANDOM_32_CHAR_OR_LONGER_SECRET_KEY"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

CORS_ORIGIN=http://localhost:5173

# Base URL of the web client, used to build account-recovery email links
# (password reset, email verification). Optional — defaults to the first
# CORS_ORIGIN entry when unset.
# FRONTEND_URL=http://localhost:5173

# Trusted reverse-proxy hop count for resolving the client IP (rate limiting).
# 0 = app is exposed directly (X-Forwarded-For ignored, cannot be spoofed).
# Set to 1 when running behind a single nginx/Cloudflare, etc.
TRUST_PROXY=0

# Used by docker-compose only. Local dev (non-docker) can ignore these.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=englishflow
POSTGRES_PORT=5433

# Host port for the dockerized web client (nginx). Open http://localhost:8081.
WEB_PORT=8081
