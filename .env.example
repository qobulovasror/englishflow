NODE_ENV=development
PORT=3000

# pino log level (trace|debug|info|warn|error|fatal|silent). Defaults to `info`
# (`silent` under NODE_ENV=test). Logs are pretty-printed in dev, JSON otherwise.
# LOG_LEVEL=info

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/englishflow?schema=public"

# JWT — keep access tokens short-lived; clients rotate them via /auth/refresh.
JWT_SECRET="REPLACE_WITH_RANDOM_32_CHAR_OR_LONGER_SECRET_KEY"
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

CORS_ORIGIN=http://localhost:5173

# Transactional email (password reset, email verification). Leave SMTP_HOST
# unset in dev — the mailer prints the message + link to the console instead
# of sending. Fill ONE of the options below to send for real.
#
# Option A — Gmail (no domain needed; simplest). Requires 2-Step Verification
# on the Google account, then an App Password (myaccount.google.com/apppasswords).
# MAIL_FROM must equal SMTP_USER — Gmail rewrites any other From address.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your16charapppassword
# MAIL_FROM="EnglishFlow <you@gmail.com>"
#
# Option B — Brevo (no domain needed; verify a single sender email, no DNS).
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login
# SMTP_PASS=your-brevo-smtp-key
# MAIL_FROM="EnglishFlow <your-verified-email@gmail.com>"
#
# Option C — Resend (custom domain; needs SPF/DKIM DNS, best deliverability).
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="EnglishFlow <no-reply@englishflow.app>"

# Base URL of the web client, used to build account-recovery email links
# (password reset, email verification). Optional — defaults to the first
# CORS_ORIGIN entry when unset.
# FRONTEND_URL=http://localhost:5173

# Trusted reverse-proxy hop count for resolving the client IP (rate limiting).
# 0 = app is exposed directly (X-Forwarded-For ignored, cannot be spoofed).
# Set to 1 when running behind a single nginx/Cloudflare, etc.
TRUST_PROXY=0

# Used by docker-compose only. Local dev (non-docker) can ignore these.
# WARNING: `postgres` is a throwaway local password. For any shared/prod
# deployment set a strong, unique POSTGRES_PASSWORD (compose fails fast if unset).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=englishflow
POSTGRES_PORT=5433

# Host port for the dockerized web client (nginx). Open http://localhost:8081.
WEB_PORT=8081
